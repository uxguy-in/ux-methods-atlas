{
  "name": "ux-methods-atlas",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "A deep atlas of UX research methods, lost methods and cross-domain borrowings, with a guided method finder and an AI research brief.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c auto \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "check:data": "node server/scripts/check-data.js",
    "check:plan": "node server/scripts/check-plan.js",
    "check:calc": "node server/scripts/check-calc.js",
    "check:summaries": "node server/scripts/check-summaries.js",
    "check:tools": "node server/scripts/check-tools.js",
    "check:studytools": "node server/scripts/check-studytools.js",
    "check:surveystats": "node server/scripts/check-surveystats.js",
    "check:conjoint": "node server/scripts/check-conjoint.js",
    "check:expanalytics": "node server/scripts/check-expanalytics.js",
    "check:runners": "node server/scripts/check-runners.js",
    "check:scorers": "node server/scripts/check-scorers.js",
    "check:signals": "node server/scripts/check-signals.js",
    "check:statsbench": "node server/scripts/check-statsbench.js",
    "check:decisions": "node server/scripts/check-decisions.js",
    "check:cogia": "node server/scripts/check-cogia.js",
    "check:causal": "node server/scripts/check-causal.js",
    "check:surveyx": "node server/scripts/check-surveyx.js",
    "check:humanfactors": "node server/scripts/check-humanfactors.js",
    "check:sensors": "node server/scripts/check-sensors.js",
    "check:guides": "node server/scripts/check-guides.js",
    "check:qual": "node server/scripts/check-qual.js",
    "check:biases": "node server/scripts/check-biases.js",
    "build:pages": "vite build --mode pages --base ./ --outDir ../site && node server/scripts/copy-data.js site"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "vite": "^6.4.1"
  }
}
